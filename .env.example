# ---------------------------------------------------------------------------
# LLM providers (at least one key required). Free tiers only.
# ---------------------------------------------------------------------------
# Primary: Groq (https://console.groq.com/keys). Free tier ~8,000 tokens/min per model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Extra Groq models used only when the primary's per-minute token window is full.
# Groq limits are per model, so these add throughput. Comma-separated; empty to disable.
GROQ_OVERFLOW_MODELS=openai/gpt-oss-20b

# Last-resort fallback: Google Gemini (https://aistudio.google.com/apikey). Use a "lite" model:
# the free tier allows only ~20 requests/day on gemini-3.8-flash, far more on lite models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Brave Search API key (free tier) for public interview discussion.
# Without it only Hacker News (public Algolia API, no key) is searched.
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# API server (server/). Not needed for `npm run evaluate`.
# ---------------------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas free tier in production). If unset in
# development, an in-memory MongoDB starts automatically (data lost on restart).
MONGODB_URI=
MONGODB_DB=prepkit
PORT=4000
# Origin of the web app, only needed if the browser calls the API directly (CORS).
# With the default setup the web app proxies /api, so this can stay empty.
WEB_ORIGIN=
# How many kits generate at once (protects the shared free-tier LLM budget).
MAX_CONCURRENT_GENERATIONS=2
# Fetching private/loopback addresses (SSRF guard). Default: allowed unless
# NODE_ENV=production. The batch command allows them (graders serve sites on
# localhost) unless this is explicitly "false".
ALLOW_PRIVATE_HOSTS=

# ---------------------------------------------------------------------------
# Web app (web/)
# ---------------------------------------------------------------------------
# Where Next.js proxies /api/* to. Local default: http://localhost:4000
API_URL=
